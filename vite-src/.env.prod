# Player build: only the main server, files and server status from the public S3 bucket.
# VITE_API_URL is the bucket root that holds files/servers.json, files/launcher-manifest.json
# and files/releases/<id>/, e.g. https://s3.twcstorage.ru/<bucket>/
VITE_PROFILE=prod
VITE_API_URL=https://s3.twcstorage.ru/s3-loot-goblins/
VITE_SERVER_PICKER=0
# Public half of the panel's ed25519 signing key (kuberheim MCP bucket: publicKey). Without a valid
# signature by it the player build refuses the manifest and the server list.
VITE_MANIFEST_KEY=MCowBQYDK2VwAyEA40bNw4Z0AnjD0r7X8YlUvVybKsDq+bMqRS37hLBTKUs=

{
  "name": "vlauncher",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:extension && vite",
    "typecheck": "tsc -b && tsc -p extension/tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "build:extension": "node esbuild.extension.config.mjs",
    "package:extension": "pkg --config ./pkg.json ./dist/extension.cjs --targets node22-win-x64 --output ../extensions/extension.exe",
    "prepare:extension": "npm run build:extension && npm run package:extension",
    "build": "npm run typecheck && vite build && npm run prepare:extension",
    "lint": "eslint src/ && eslint extension/src/ --config extension/eslint.config.js",
    "lint:fix": "npm run lint -- --fix",
    "preview": "vite preview",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@mantine/core": "^7.16.3",
    "@mantine/hooks": "^7.16.3",
    "@neutralinojs/lib": "5.4.0",
    "@reduxjs/toolkit": "2.5.1",
    "@tabler/icons-react": "^3.30.0",
    "adm-zip": "0.6.1",
    "clsx": "2.1.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-error-boundary": "4.1.2",
    "react-redux": "9.2.0",
    "react-router": "7.18.3",
    "react-router-dom": "7.18.3",
    "tailwind-merge": "2.6.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@neutralinojs/neu": "11.7.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "22.13.1",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@types/websocket": "^1.0.10",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-v8": "4.1.11",
    "@yao-pkg/pkg": "6.22.0",
    "autoprefixer": "10.4.20",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.25.10",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.9.0",
    "jsdom": "29.1.1",
    "lefthook": "^1.12.2",
    "postcss": "^8.5.2",
    "postcss-preset-mantine": "^1.17.0",
    "prettier": "3.5.0",
    "rollup": "^4.46.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.44.0",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

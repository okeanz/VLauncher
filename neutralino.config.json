{
  "applicationId": "js.neutralino.zero",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/vite-src/dist/",
  "url": "/",
  "port": 0,
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": [
    "app.broadcast",
    "app.killProcess",
    "filesystem.readFile",
    "filesystem.readDirectory",
    "filesystem.getStats",
    "os.execCommand",
    "os.showFolderDialog",
    "debug.log",
    "storage.getData",
    "storage.setData",
    "extensions.dispatch",
    "extensions.getStats",
    "events.*",
    "window.move",
    "window.minimize"
  ],
  "singlePageServe": true,
  "enableExtensions": true,
  "extensions": [
    {
      "id": "fileLoader",
      "command": "\"${NL_PATH}/extensions/extension.exe\""
    }
  ],
  "modes": {
    "window": {
      "title": "VLauncher",
      "width": 800,
      "height": 600,
      "maxHeight": 600,
      "maxWidth": 800,
      "minHeight": 600,
      "minWidth": 800,
      "exitProcessOnClose": false,
      "resizable": false,
      "borderless": true,
      "icon": "/vite-src/public/icon.png",
      "enableInspector": false
    }
  },
  "cli": {
    "binaryName": "VLauncher",
    "resourcesPath": "/vite-src/dist/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.2.0",
    "clientVersion": "6.2.0",
    "frontendLibrary": {
      "patchFile": "/vite-src/index.html",
      "devUrl": "http://localhost:5173",
      "projectPath": "/vite-src/",
      "initCommand": "npm install",
      "devCommand": "npm run dev",
      "buildCommand": "npm run build"
    }
  }
}
